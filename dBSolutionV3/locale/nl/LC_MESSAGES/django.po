#: facture/templates/facture/tva.html:215
#, python-format
msgid ""
"%(n)s maintenance interne (facture à notre société) n'est pas une vente : la "
"TVA sur ses pièces est récupérée via les achats fournisseurs."
msgid_plural ""
"%(n)s maintenances internes (factures à notre société) ne sont pas des "
"ventes : la TVA sur leurs pièces est récupérée via les achats fournisseurs."
msgstr[0] ""
"%(n)s intern onderhoud (factuur aan ons bedrijf) is geen verkoop: de btw op "
"de onderdelen wordt teruggevorderd via de aankopen bij leveranciers."
msgstr[1] ""
"%(n)s interne onderhouden (facturen aan ons bedrijf) zijn geen verkopen: de "
"btw op de onderdelen wordt teruggevorderd via de aankopen bij leveranciers."

