#: maintenance/autres_interventions/batterie/models.py:192
msgid "Technologie de la batterie neuve"
msgstr "Τεχνολογία της νέας μπαταρίας"

#: maintenance/autres_interventions/batterie/models.py:193
msgid "Tension nominale de la batterie neuve (V)"
msgstr "Ονομαστική τάση της νέας μπαταρίας (V)"

#: maintenance/autres_interventions/batterie/models.py:194
msgid "Capacité de la batterie neuve (Ah)"
msgstr "Χωρητικότητα της νέας μπαταρίας (Ah)"

#: maintenance/autres_interventions/batterie/models.py:195
msgid "Courant de démarrage de la batterie neuve (A EN)"
msgstr "Ρεύμα εκκίνησης της νέας μπαταρίας (A EN)"

#: maintenance/autres_interventions/batterie/models.py:196
msgid "Batterie enregistrée / codée dans le véhicule (BMS)"
msgstr "Μπαταρία καταχωρισμένη / κωδικοποιημένη στο όχημα (BMS)"

#: maintenance/autres_interventions/batterie/models.py:196
msgid ""
"Obligatoire sur de nombreux véhicules Start & Stop (BMW, VAG, Mercedes…)."
msgstr "Υποχρεωτικό σε πολλά οχήματα Start & Stop (BMW, VAG, Mercedes…)."

#: maintenance/autres_interventions/batterie/models.py:293
msgid ""
"Le kilométrage de la batterie ne peut pas être inférieur au kilométrage du "
"véhicule."
msgstr ""
"Τα χιλιόμετρα της μπαταρίας δεν μπορούν να είναι λιγότερα από τα χιλιόμετρα "
"του οχήματος."

#: maintenance/autres_interventions/batterie/models.py:340
#, python-format
msgid ""
"La tension doit être identique à celle de la batterie d'origine (%(v)s V)."
msgstr "Η τάση πρέπει να είναι ίδια με αυτή της αρχικής μπαταρίας (%(v)s V)."

#: maintenance/autres_interventions/batterie/models.py:344
msgid "Indiquez la capacité (Ah) de la batterie neuve."
msgstr "Συμπληρώστε τη χωρητικότητα (Ah) της νέας μπαταρίας."

#: maintenance/autres_interventions/batterie/models.py:347
#, python-format
msgid "La capacité doit être au moins égale à celle d'origine (%(ah)s Ah)."
msgstr ""
"Η χωρητικότητα πρέπει να είναι τουλάχιστον ίση με την αρχική (%(ah)s Ah)."

#: maintenance/autres_interventions/batterie/models.py:351
msgid "Indiquez le courant de démarrage (A EN) de la batterie neuve."
msgstr "Συμπληρώστε το ρεύμα εκκίνησης (A EN) της νέας μπαταρίας."

#: maintenance/autres_interventions/batterie/models.py:354
#, python-format
msgid ""
"Le courant de démarrage doit être au moins égal à celui d'origine (%(a)s A "
"EN)."
msgstr ""
"Το ρεύμα εκκίνησης πρέπει να είναι τουλάχιστον ίσο με το αρχικό (%(a)s A EN)."

#: maintenance/autres_interventions/batterie/models.py:360
#, python-format
msgid ""
"Technologie incompatible avec la batterie d'origine (%(orig)s). Technologies "
"acceptées : %(ok)s."
msgstr ""
"Τεχνολογία μη συμβατή με την αρχική μπαταρία (%(orig)s). Αποδεκτές "
"τεχνολογίες: %(ok)s."

#: maintenance/autres_interventions/batterie/models.py:401
msgid ""
"Batterie lithium : l'état de charge ne se déduit pas de la tension au repos."
msgstr ""
"Μπαταρία λιθίου: η κατάσταση φόρτισης δεν προκύπτει από την τάση ηρεμίας."

#: maintenance/autres_interventions/batterie/models.py:404
#, python-format
msgid "Tension au repos %(v)s V → état de charge estimé %(soc)s %%."
msgstr "Τάση ηρεμίας %(v)s V → εκτιμώμενη κατάσταση φόρτισης %(soc)s %%."

#: maintenance/autres_interventions/batterie/models.py:408
msgid ""
"Décharge profonde : recharger puis retester. Si la tension ne tient pas, "
"remplacer."
msgstr ""
"Βαθιά εκφόρτιση: επαναφόρτιση και επανέλεγχος. Αν η τάση δεν διατηρείται, "
"αντικατάσταση."

#: maintenance/autres_interventions/batterie/models.py:410
msgid "Batterie insuffisamment chargée : recharger avant de conclure."
msgstr "Μπαταρία ανεπαρκώς φορτισμένη: φορτίστε πριν από το συμπέρασμα."

#: maintenance/autres_interventions/batterie/models.py:417
#, python-format
msgid "Courant de démarrage mesuré %(m)s A pour %(n)s A nominal (%(r)s %%)."
msgstr "Μετρημένο ρεύμα εκκίνησης %(m)s A για %(n)s A ονομαστικό (%(r)s %%)."

#: maintenance/autres_interventions/batterie/models.py:420
msgid "Moins de 60 % du courant nominal : batterie usée."
msgstr "Λιγότερο από 60 % του ονομαστικού ρεύματος: φθαρμένη μπαταρία."

#: maintenance/autres_interventions/batterie/models.py:423
msgid "Entre 60 et 80 % du courant nominal : batterie faible."
msgstr "Μεταξύ 60 και 80 % του ονομαστικού ρεύματος: αδύναμη μπαταρία."

#: maintenance/autres_interventions/batterie/models.py:430
#, python-format
msgid "État de santé %(soh)s %% : remplacement conseillé."
msgstr "Κατάσταση υγείας %(soh)s %%: συνιστάται αντικατάσταση."

#: maintenance/autres_interventions/batterie/models.py:433
#, python-format
msgid "État de santé %(soh)s %% : batterie fatiguée."
msgstr "Κατάσταση υγείας %(soh)s %%: κουρασμένη μπαταρία."

#: maintenance/autres_interventions/batterie/models.py:442
#, python-format
msgid ""
"Tension au démarrage %(v)s V inférieure à %(s)s V avec une batterie chargée :"
" batterie usée."
msgstr ""
"Τάση εκκίνησης %(v)s V κάτω από %(s)s V με φορτισμένη μπαταρία: φθαρμένη "
"μπαταρία."

#: maintenance/autres_interventions/batterie/models.py:445
#, python-format
msgid ""
"Tension au démarrage %(v)s V trop basse : recharger puis refaire le test."
