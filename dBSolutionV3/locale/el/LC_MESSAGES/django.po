msgid "Perte de puissance / ratés"
msgstr "Απώλεια ισχύος / αστοχίες ανάφλεξης"

#: maintenance/autres_interventions/moteur/casse_moteur/models.py:201
msgid "Surchauffe"
msgstr "Υπερθέρμανση"

#: maintenance/autres_interventions/moteur/casse_moteur/models.py:202
msgid "Voyant de pression d'huile"
msgstr "Λυχνία πίεσης λαδιού"

#: maintenance/autres_interventions/moteur/casse_moteur/models.py:203
