#: maintenance/autres_interventions/moteur/casse_moteur/templates/casse_moteur/casse_detail_pdf.html:334
msgid "Date de la casse"
msgstr "Ημερομηνία βλάβης"

#: maintenance/autres_interventions/boite_de_vitesse/casse_boite/models.py:250
msgid ""
"Conditions au moment de la casse : rapport engagé, régime, départ, piste, "
"bruit avant la casse…"
msgstr ""
"Συνθήκες τη στιγμή της βλάβης: ταχύτητα, στροφές, εκκίνηση, πίστα, θόρυβος "
"πριν…"

