msgstr "Μια ταχύτητα πετάγεται / βγαίνει"

#: maintenance/autres_interventions/boite_de_vitesse/casse_boite/models.py:258
msgid "Passage dur / accrochage"
msgstr "Σκληρή / κολλημένη αλλαγή"

#: maintenance/autres_interventions/boite_de_vitesse/casse_boite/models.py:259
msgid "Vitesse impossible à engager"
msgstr "Αδύνατο να μπει ταχύτητα"

#: maintenance/autres_interventions/boite_de_vitesse/casse_boite/models.py:260
msgid "Levier flottant / sans résistance"
msgstr "Χαλαρός λεβιές / χωρίς αντίσταση"

#: maintenance/autres_interventions/boite_de_vitesse/casse_boite/models.py:261
msgid "Sifflement / ronflement (varie avec la vitesse)"
msgstr "Σφύριγμα / βουητό (αλλάζει με την ταχύτητα)"

