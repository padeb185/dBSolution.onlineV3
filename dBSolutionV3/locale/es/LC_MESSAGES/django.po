#: maintenance/autres_interventions/moteur/casse_moteur/models.py:134
msgid ""
"Bielle cassée sortie du bloc : contrôler vilebrequin, bielle, piston, "
"coussinets ; bloc généralement irréparable."
msgstr ""
"Biela rota que ha salido del bloque: comprobar cigüeñal, biela, pistón, "
"cojinetes; bloque generalmente irreparable."

#: maintenance/autres_interventions/moteur/casse_moteur/models.py:135
msgid ""
"Coussinets de bielle / de palier fondus suite à un manque de pression "
"d'huile : contrôler pompe à huile, crépine, niveau."
msgstr ""
"Cojinetes de biela / de bancada fundidos por falta de presión de aceite: "
"comprobar bomba de aceite, colador, nivel."

#: maintenance/autres_interventions/moteur/casse_moteur/models.py:136
msgid ""
"Usure ou fusion de coussinets, grippage : déposer le carter et contrôler "
"bielles, vilebrequin, coussinets."
msgstr ""
"Desgaste o fusión de cojinetes, gripado: desmontar el cárter y comprobar "
"bielas, cigüeñal, cojinetes."

#: maintenance/autres_interventions/moteur/casse_moteur/models.py:137
msgid ""
"Liquide de refroidissement brûlé : joint de culasse, culasse ou chemise "
"fissurée."
msgstr ""
"Líquido refrigerante quemado: junta de culata, culata o camisa agrietada."

#: maintenance/autres_interventions/moteur/casse_moteur/models.py:138
msgid ""
"Huile dans le refroidissement : joint de culasse, échangeur huile / eau."
msgstr ""
"Aceite en el refrigerante: junta de culata, intercambiador aceite / agua."

#: maintenance/autres_interventions/moteur/casse_moteur/models.py:139
msgid ""
"Eau dans l'huile : joint de culasse, culasse fissurée, chemise poreuse ou "
"joint d'embase."
msgstr ""
"Agua en el aceite: junta de culata, culata agrietada, camisa porosa o junta "
"de base."

#: maintenance/autres_interventions/moteur/casse_moteur/models.py:140
msgid ""
"Surchauffe : contrôler planéité de culasse, joint de culasse, pompe à eau, "
"thermostat, radiateur ; risque de grippage des pistons."
msgstr ""
"Sobrecalentamiento: comprobar planitud de la culata, junta de culata, bomba "
"de agua, termostato, radiador; riesgo de gripado de pistones."

#: maintenance/autres_interventions/moteur/casse_moteur/models.py:141
msgid ""
"Huile brûlée : segments, pistons, guides / joints de queue de soupape ou "
"turbo."
msgstr ""
"Aceite quemado: segmentos, pistones, guías / retenes de válvula o turbo."

#: maintenance/autres_interventions/moteur/casse_moteur/models.py:142
msgid ""
"Consommation d'huile : segments collés ou usés, ovalisation des cylindres, "
"turbo, reniflard."
msgstr ""
"Consumo de aceite: segmentos pegados o desgastados, ovalización de los "
"cilindros, turbo, respiradero."

#: maintenance/autres_interventions/moteur/casse_moteur/models.py:143
msgid ""
"Excès de carburant : injecteur fuyard ou bloqué ouvert, risque de dilution "
"et de piston percé."
msgstr ""
"Exceso de combustible: inyector con fuga o bloqueado abierto, riesgo de "
"dilución y pistón perforado."

#: maintenance/autres_interventions/moteur/casse_moteur/models.py:144
msgid ""
"Moteur bloqué : grippage piston / bielle, coup de bélier, soupape tombée, "
"corps étranger."
msgstr ""
"Motor bloqueado: gripado de pistón / biela, golpe de ariete, válvula caída, "
"cuerpo extraño."

#: maintenance/autres_interventions/moteur/casse_moteur/models.py:145
msgid ""
"Perte de compression : soupapes (rupture ou saut de distribution), segments, "
"joint de culasse ; faire un test d'étanchéité."
msgstr ""
"Pérdida de compresión: válvulas (rotura o salto de la distribución), "
"segmentos, junta de culata; realizar una prueba de estanqueidad."

#: maintenance/autres_interventions/moteur/casse_moteur/models.py:146
msgid ""
"Ne démarre plus : contrôler la distribution (calage, rupture) et la "
"compression de chaque cylindre."
msgstr ""
"Ya no arranca: comprobar la distribución (calado, rotura) y la compresión de "
"cada cilindro."

