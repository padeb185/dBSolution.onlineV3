#: utilisateurs/templates/utilisateurs/paie/_conges_regles.html:3
msgid "Rappel des règles belges (congés payés, pécules, 13e mois)"
msgstr "Recordatorio de las normas belgas (vacaciones, pagas, 13.ª paga)"

#: utilisateurs/templates/utilisateurs/paie/_conges_regles.html:8
msgid ""
"20 jours par an pour un temps plein (5 jours / semaine) ayant travaillé "
"toute l'année précédente (exercice de vacances)."
msgstr ""
"20 días al año a tiempo completo (5 días / semana) habiendo trabajado todo "
"el año anterior."

#: utilisateurs/templates/utilisateurs/paie/_conges_regles.html:9
msgid ""
"Temps partiel ou année incomplète : au prorata (régime de travail, jours "
"prestés ou assimilés)."
msgstr ""
"Tiempo parcial o año incompleto: a prorrata (régimen, días trabajados o "
"asimilados)."

#: utilisateurs/templates/utilisateurs/paie/_conges_regles.html:10
msgid ""
"Les jours doivent être pris avant le 31 décembre ; ils ne sont pas "
"reportables ni payables (sauf à la sortie)."
msgstr ""
"Los días deben tomarse antes del 31 de diciembre; no se trasladan ni se "
"pagan (salvo a la salida)."

#: utilisateurs/templates/utilisateurs/paie/_conges_regles.html:11
msgid "Salaire journalier d'un employé : salaire mensuel × 3 / 65."
msgstr "Salario diario de un empleado: salario mensual × 3 / 65."

#: utilisateurs/templates/utilisateurs/paie/_conges_regles.html:15
#: utilisateurs/templates/utilisateurs/paie/conges_travailleur.html:120
msgid "Pécule de vacances"
msgstr "Paga de vacaciones"

#: utilisateurs/templates/utilisateurs/paie/_conges_regles.html:17
#, python-format
msgid ""
"simple pécule = salaire maintenu pendant les jours pris ; double pécule = 92 "
"%% du brut mensuel, payé en général en mai / juin."
msgstr ""
"paga simple = salario mantenido durante los días tomados; doble paga = 92 %% "
"del bruto mensual, normalmente en mayo / junio."

#: utilisateurs/templates/utilisateurs/paie/_conges_regles.html:18
#, python-format
msgid ""
"ONSS sur le double pécule : 13,07 %% calculés sur 85 %% (la part de 7 %% "
"n'est pas soumise) ; précompte au taux des allocations exceptionnelles."
msgstr ""
"ONSS sobre la doble paga: 13,07 %% sobre 85 %% (la parte del 7 %% está "
"exenta); retención al tipo de asignaciones excepcionales."

#: utilisateurs/templates/utilisateurs/paie/_conges_regles.html:19
#, python-format
msgid ""
"payé par la caisse de vacances : 15,38 %% du brut à 108 %% de l'année "
"précédente (8 %% simple + 7,38 %% double). L'employeur cotise 15,84 %% du "
"brut à 108 %%."
msgstr ""
"pagada por la caja de vacaciones: 15,38 %% del bruto al 108 %% del año "
"anterior (8 %% simple + 7,38 %% doble). El empleador cotiza 15,84 %% del "
"bruto al 108 %%."

#: utilisateurs/templates/utilisateurs/paie/_conges_regles.html:25
msgid ""
"un salaire mensuel brut, au prorata des mois prestés ou assimilés de l'année "
"civile, payé en décembre."
msgstr ""
"un salario mensual bruto, a prorrata de los meses trabajados o asimilados "
"del año natural, pagado en diciembre."

#: utilisateurs/templates/utilisateurs/paie/_conges_regles.html:26
msgid ""
"taux horaire au 1er décembre × 38 h × 52 / 12, période du 1er décembre au 30 "
"novembre, payée au plus tard le 20 décembre (minimum 3 mois d'ancienneté)."
msgstr ""
"tarifa horaria al 1 de diciembre × 38 h × 52 / 12, periodo del 1 de "
"diciembre al 30 de noviembre, pagada a más tardar el 20 de diciembre (mínimo "
"3 meses de antigüedad)."

#: utilisateurs/templates/utilisateurs/paie/_conges_regles.html:27
#, python-format
msgid ""
"ONSS 13,07 %% (sur 108 %% pour un ouvrier), sans bonus à l'emploi ; "
"précompte au taux des allocations exceptionnelles."
msgstr ""
"ONSS 13,07 %% (sobre 108 %% para un obrero), sin bonus al empleo; retención "
"al tipo de asignaciones excepcionales."

#: utilisateurs/templates/utilisateurs/paie/_conges_regles.html:31
