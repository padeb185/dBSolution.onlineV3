msgstr "Pérdida de potencia / fallos de encendido"

#: maintenance/autres_interventions/moteur/casse_moteur/models.py:201
msgid "Surchauffe"
msgstr "Sobrecalentamiento"

#: maintenance/autres_interventions/moteur/casse_moteur/models.py:202
msgid "Voyant de pression d'huile"
msgstr "Testigo de presión de aceite"

#: maintenance/autres_interventions/moteur/casse_moteur/models.py:203
msgid "Huile dans le liquide de refroidissement"
msgstr "Aceite en el líquido refrigerante"

#: maintenance/autres_interventions/moteur/casse_moteur/models.py:204
msgid "Liquide de refroidissement dans l'huile (mayonnaise)"
msgstr "Refrigerante en el aceite (mayonesa)"

#: maintenance/autres_interventions/moteur/casse_moteur/models.py:205
msgid "Limaille / débris dans l'huile ou le filtre"
msgstr "Limaduras / restos en el aceite o el filtro"

#: maintenance/autres_interventions/moteur/casse_moteur/models.py:206
msgid "Consommation d'huile excessive"
msgstr "Consumo de aceite excesivo"

#: maintenance/autres_interventions/moteur/casse_moteur/models.py:207
msgid "Fuite externe (huile, liquide)"
msgstr "Fuga externa (aceite, líquido)"

#: maintenance/autres_interventions/moteur/casse_moteur/models.py:208
