#: maintenance/autres_interventions/batterie/models.py:192
msgid "Technologie de la batterie neuve"
msgstr "Tecnología de la batería nueva"

#: maintenance/autres_interventions/batterie/models.py:193
msgid "Tension nominale de la batterie neuve (V)"
msgstr "Tensión nominal de la batería nueva (V)"

#: maintenance/autres_interventions/batterie/models.py:194
msgid "Capacité de la batterie neuve (Ah)"
msgstr "Capacidad de la batería nueva (Ah)"

#: maintenance/autres_interventions/batterie/models.py:195
msgid "Courant de démarrage de la batterie neuve (A EN)"
msgstr "Corriente de arranque de la batería nueva (A EN)"

#: maintenance/autres_interventions/batterie/models.py:196
msgid "Batterie enregistrée / codée dans le véhicule (BMS)"
msgstr "Batería registrada / codificada en el vehículo (BMS)"

#: maintenance/autres_interventions/batterie/models.py:196
msgid ""
"Obligatoire sur de nombreux véhicules Start & Stop (BMW, VAG, Mercedes…)."
msgstr "Obligatorio en muchos vehículos Start & Stop (BMW, VAG, Mercedes…)."

#: maintenance/autres_interventions/batterie/models.py:293
msgid ""
"Le kilométrage de la batterie ne peut pas être inférieur au kilométrage du "
"véhicule."
msgstr ""
"El kilometraje de la batería no puede ser inferior al kilometraje del "
"vehículo."

#: maintenance/autres_interventions/batterie/models.py:340
#, python-format
msgid ""
"La tension doit être identique à celle de la batterie d'origine (%(v)s V)."
msgstr "La tensión debe ser idéntica a la de la batería original (%(v)s V)."

#: maintenance/autres_interventions/batterie/models.py:344
msgid "Indiquez la capacité (Ah) de la batterie neuve."
msgstr "Indique la capacidad (Ah) de la batería nueva."

#: maintenance/autres_interventions/batterie/models.py:347
#, python-format
msgid "La capacité doit être au moins égale à celle d'origine (%(ah)s Ah)."
msgstr "La capacidad debe ser al menos igual a la original (%(ah)s Ah)."

#: maintenance/autres_interventions/batterie/models.py:351
msgid "Indiquez le courant de démarrage (A EN) de la batterie neuve."
msgstr "Indique la corriente de arranque (A EN) de la batería nueva."

#: maintenance/autres_interventions/batterie/models.py:354
#, python-format
msgid ""
"Le courant de démarrage doit être au moins égal à celui d'origine (%(a)s A "
"EN)."
msgstr ""
"La corriente de arranque debe ser al menos igual a la original (%(a)s A EN)."

#: maintenance/autres_interventions/batterie/models.py:360
#, python-format
msgid ""
"Technologie incompatible avec la batterie d'origine (%(orig)s). Technologies"
" acceptées : %(ok)s."
msgstr ""
"Tecnología incompatible con la batería original (%(orig)s). Tecnologías "
"aceptadas: %(ok)s."

#: maintenance/autres_interventions/batterie/models.py:401
msgid ""
"Batterie lithium : l'état de charge ne se déduit pas de la tension au repos."
msgstr ""
"Batería de litio: el estado de carga no se deduce de la tensión en reposo."

#: maintenance/autres_interventions/batterie/models.py:404
#, python-format
msgid "Tension au repos %(v)s V → état de charge estimé %(soc)s %%."
msgstr "Tensión en reposo %(v)s V → estado de carga estimado %(soc)s %%."

#: maintenance/autres_interventions/batterie/models.py:408
msgid ""
"Décharge profonde : recharger puis retester. Si la tension ne tient pas, "
"remplacer."
msgstr ""
"Descarga profunda: recargar y volver a probar. Si la tensión no se mantiene,"
" sustituir."

#: maintenance/autres_interventions/batterie/models.py:410
msgid "Batterie insuffisamment chargée : recharger avant de conclure."
msgstr "Batería insuficientemente cargada: recargar antes de concluir."

#: maintenance/autres_interventions/batterie/models.py:417
#, python-format
msgid "Courant de démarrage mesuré %(m)s A pour %(n)s A nominal (%(r)s %%)."
msgstr ""
"Corriente de arranque medida %(m)s A para %(n)s A nominales (%(r)s %%)."

#: maintenance/autres_interventions/batterie/models.py:420
